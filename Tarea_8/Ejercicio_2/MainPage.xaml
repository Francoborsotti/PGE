<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ejercicio_2.MainPage"
             Title="Recursos locales">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Guardar / Abrir texto (AppDataDirectory)" FontAttributes="Bold" FontSize="20"/>

        <Entry x:Name="FileNameEntry" Placeholder="Nombre archivo (ej: nota.txt)" Text="nota.txt" />
        <Editor x:Name="TextEditor" HeightRequest="180" Placeholder="Escribi tu texto aqui..." />

        <HorizontalStackLayout Spacing="8">
            <Button Text="Guardar" Clicked="OnGuardarClicked"/>
            <Button Text="Abrir" Clicked="OnAbrirClicked"/>
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Text="Estado: -"/>
    </VerticalStackLayout>
</ContentPage>
